PORT=5002
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname?sslmode=disable
JWT_SECRET=tu_clave_secreta_super_segura
JWT_EXPIRES_IN=24h

# Clave para cifrar credenciales sensibles guardadas en la base (hoy solo
# AtlasConfig.Clave, ver services/secrets_crypto.go) con AES-256-GCM. Puede
# ser cualquier string (se deriva a 32 bytes con SHA-256) — pero tiene que
# ser estable: si cambia, ya no se van a poder desencriptar los valores
# guardados con la clave anterior. Si no está seteada, las credenciales se
# guardan sin cifrar (mismo comportamiento que antes de que esto existiera).
SECRETS_ENCRYPTION_KEY=

# URL del frontend para CORS (obligatorio en producción)
URL_FRONTEND=https://app-cupos-frontend.vercel.app

# Secreto para GET /api/cron/expire-reservations (header X-Cron-Secret).
# Configurar un cron externo (cron-job.org, GitHub Actions, etc.) cada 5-15 min.
CRON_SECRET=

# SMTP global de fallback, usado cuando una agencia no tiene su propio
# EmailSMTPConfig configurado desde /email-config
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# URLs base de Netviax Atlas (backoffice). Las credenciales (Usuario/Clave/
# Empresa/Sucursal) se configuran por agencia desde /atlas-config, no acá.
# Sandbox: 500 intermitentes conocidos por Netviax, no necesariamente un bug propio.
# Desde 01/07/2026 Netviax filtra por IP de origen: pedirles que habiliten la
# IP de salida del servidor donde termine corriendo el backend.
ATLAS_API_URL_PROD=https://api-atlas-netviax-com.azurewebsites.net/rest
ATLAS_API_URL_TEST=https://api-atlas-netviax-com-test.azurewebsites.net/rest


